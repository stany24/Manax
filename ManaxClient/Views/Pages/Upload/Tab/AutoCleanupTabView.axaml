<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:ManaxClient.ViewModels"
    xmlns:tab="clr-namespace:ManaxClient.ViewModels.Pages.Upload.Tab"
    xmlns:localization="clr-namespace:Jeek.Avalonia.Localization;assembly=Jeek.Avalonia.Localization"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="ManaxClient.Views.Pages.Upload.Tab.AutoCleanupTabView"
    x:DataType="tab:AutoCleanupTabViewModel"
    IsVisible="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).PermissionManager.CanUploadChapter}"
    Classes="page">

    <StackPanel Orientation="Vertical"
                Spacing="24">

        <Border Classes="card">
            <Grid Classes="title"
                  ColumnDefinitions="Auto,Auto,*,Auto">
                <avalonia:MaterialIcon Grid.Column="0"
                                       Classes="icon"
                                       Kind="Broom" />
                <TextBlock Grid.Column="1"
                           Text="{localization:Localize AutoCleanupPage.Title}" />
                <Button Grid.Column="3"
                        Classes="button light"
                        Content="{localization:Localize AutoCleanupPage.Skip}"
                        Command="{Binding Skip}" />
            </Grid>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="12">
                <Border Classes="item-card">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{localization:Localize AutoCleanupPage.ArchiveProcessing}"
                                       FontWeight="SemiBold"
                                       FontSize="14" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="{Binding CurrentArchive}" Opacity="0.7" />
                                <TextBlock Text="/" Opacity="0.7" />
                                <TextBlock Text="{Binding NbArchive}" Opacity="0.7" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar Value="{Binding CurrentArchive}"
                                     Maximum="{Binding NbArchive}"
                                     Height="8"
                                     CornerRadius="4"
                                     ShowProgressText="False" />
                    </StackPanel>
                </Border>

                <Border Classes="item-card">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{localization:Localize AutoCleanupPage.ImageProcessing}"
                                       FontWeight="SemiBold"
                                       FontSize="14" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="{Binding CurrentImage}" Opacity="0.7" />
                                <TextBlock Text="/" Opacity="0.7" />
                                <TextBlock Text="{Binding NbImage}" Opacity="0.7" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar Value="{Binding CurrentImage}"
                                     Maximum="{Binding NbImage}"
                                     Height="8"
                                     CornerRadius="4"
                                     ShowProgressText="False" />
                    </StackPanel>
                </Border>

                <Button Classes="button light"
                        Command="{Binding Clean}"
                        IsEnabled="{Binding !IsProcessing}"
                        HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal">
                        <avalonia:MaterialIcon Classes="icon"
                                               Kind="PlayOutline"
                                               IsVisible="{Binding !IsProcessing}" />
                        <TextBlock Text="{localization:Localize AutoCleanupPage.StartCleanup}"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding !IsProcessing}" />

                        <avalonia:MaterialIcon Classes="icon"
                                               Kind="TimerSand"
                                               IsVisible="{Binding IsProcessing}" />
                        <TextBlock Text="{localization:Localize AutoCleanupPage.Processing}"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsProcessing}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border Classes="card"
                HorizontalAlignment="Center"
                IsVisible="{Binding Errors.Count}">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="⚠️" FontSize="20" VerticalAlignment="Center" />
                    <TextBlock Text="{localization:Localize AutoCleanupPage.Errors}"
                               FontWeight="SemiBold"
                               FontSize="16"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Errors.Count, StringFormat='({0})'}"
                               Opacity="0.7"
                               VerticalAlignment="Center" />
                </StackPanel>

                <ScrollViewer HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Errors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource SystemControlErrorTextForegroundBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8"
                                        Margin="0,4">
                                    <TextBlock Text="{Binding}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
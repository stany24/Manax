<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:ManaxClient.ViewModels"
    xmlns:tab="clr-namespace:ManaxClient.ViewModels.Pages.Upload.Tab"
    xmlns:upload="clr-namespace:ManaxClient.Models.Upload"
    xmlns:localization="clr-namespace:Jeek.Avalonia.Localization;assembly=Jeek.Avalonia.Localization"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="ManaxClient.Views.Pages.Upload.Tab.ConfigureUploadTabView"
    x:DataType="tab:ConfigureUploadTabViewModel"
    IsVisible="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).CanUploadChapter}">
    
    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,*" Margin="16">
        
        <!-- Header -->
        <TextBlock Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" 
                   Classes="title" 
                   Text="{localization:Localize ConfigureUploadPage.Title}" 
                   Margin="0,0,0,16"/>
        
        <!-- Left Panel: Source Folders -->
        <Border Grid.Column="0" Grid.Row="1" 
                Classes="card" 
                Margin="0,0,8,0">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                
                <!-- Source Folders Header -->
                <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
                    <TextBlock Classes="subtitle"
                               Text="{localization:Localize ConfigureUploadPage.SourceFolders}"
                               FontWeight="SemiBold"
                               FontSize="16"/>
                    <TextBlock Text="{localization:Localize ConfigureUploadPage.SourceFolders.Description}"
                               FontSize="12"
                               Opacity="0.7"
                               TextWrapping="Wrap"/>
                </StackPanel>
                
                <!-- Source List or Empty State -->
                <Border Grid.Row="1" Grid.RowSpan="2"
                        IsVisible="{Binding SourceFolders.Count, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}">
                    <StackPanel VerticalAlignment="Center" 
                                HorizontalAlignment="Center"
                                Spacing="12"
                                Margin="24">
                        <TextBlock Text="📁" 
                                   FontSize="48" 
                                   HorizontalAlignment="Center"
                                   Opacity="0.5"/>
                        <TextBlock Text="{localization:Localize ConfigureUploadPage.NoSources}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Opacity="0.7"
                                   MaxWidth="300"/>
                    </StackPanel>
                </Border>
                
                <!-- Sources List -->
                <ScrollViewer Grid.Row="2" 
                              VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding SourceFolders.Count, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter=0}">
                    <ItemsControl ItemsSource="{Binding SourceFolders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="upload:Source">
                                <Border Classes="task-item" 
                                        Margin="0,0,0,8"
                                        Padding="12">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        
                                        <!-- Folder Icon -->
                                        <TextBlock Grid.Column="0"
                                                   Text="📁" 
                                                   FontSize="20"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>
                                        
                                        <!-- Path -->
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding Path}" 
                                                   FontWeight="Medium"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   ToolTip.Tip="{Binding Path}"/>
                                        
                                        <!-- Remove Button -->
                                        <Button Grid.Column="2"
                                                Content="{localization:Localize ConfigureUploadPage.RemoveSource}"
                                                Classes="secondary"
                                                Command="{Binding $parent[UserControl].((tab:ConfigureUploadTabViewModel)DataContext).RemoveSource}"
                                                CommandParameter="{Binding}"
                                                Padding="8,4"
                                                Margin="8,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <!-- Add Source Button -->
                <Button Grid.Row="3" 
                        Classes="primary" 
                        Content="{localization:Localize ConfigureUploadPage.AddSource}" 
                        HorizontalAlignment="Stretch"
                        Command="{Binding AddSource}"
                        Margin="0,12,0,0"
                        Padding="12,8"/>
            </Grid>
        </Border>
        
        <!-- Right Panel: Processing Folder -->
        <Border Grid.Column="1" Grid.Row="1" 
                Classes="card" 
                Margin="8,0,0,0">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                
                <!-- Processing Folder Header -->
                <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
                    <TextBlock Classes="subtitle"
                               Text="{localization:Localize ConfigureUploadPage.ProcessingFolder}"
                               FontWeight="SemiBold"
                               FontSize="16"/>
                    <TextBlock Text="{localization:Localize ConfigureUploadPage.ProcessingFolder.Description}"
                               FontSize="12"
                               Opacity="0.7"
                               TextWrapping="Wrap"/>
                </StackPanel>
                
                <!-- Current Path Section -->
                <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,16">
                    <TextBlock Text="{localization:Localize ConfigureUploadPage.CurrentPath}" 
                               FontWeight="Medium"
                               FontSize="13"/>
                    <Border CornerRadius="6"
                            Padding="12"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0"
                                       Text="📂" 
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ProcessingFolder}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas,Courier New,monospace"
                                       FontSize="12">
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock:empty">
                                        <Setter Property="Text" Value="No folder selected"/>
                                        <Setter Property="Opacity" Value="0.5"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </Style>
                                </TextBlock.Styles>
                            </TextBlock>
                        </Grid>
                    </Border>
                </StackPanel>
                
                <!-- Browse Button -->
                <Button Grid.Row="2"
                        Classes="primary"
                        Content="{localization:Localize ConfigureUploadPage.Browse}"
                        Command="{Binding UpdateProcessingFolder}"
                        HorizontalAlignment="Stretch"
                        Padding="12,8"
                        Margin="0,0,0,16"/>
                
                <!-- Info Section -->
                <Border Grid.Row="3"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,8,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="ℹ️ Information" 
                                   FontWeight="SemiBold"
                                   FontSize="14"/>
                        <TextBlock TextWrapping="Wrap"
                                   FontSize="12"
                                   Opacity="0.8"
                                   LineHeight="18">
                            <Run Text="The processing folder is where files from source folders will be copied for processing."/>
                            <LineBreak/>
                            <LineBreak/>
                            <Run Text="Make sure you have sufficient disk space and write permissions."/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                
                <!-- Auto-save Notice -->
                <Border Grid.Row="4"
                        Padding="12,8"
                        Margin="0,16,0,0"
                        CornerRadius="6">
                    <TextBlock Text="{localization:Localize ConfigureUploadPage.SaveSettings}"
                               FontSize="11"
                               TextAlignment="Center"
                               Opacity="0.6"
                               FontStyle="Italic"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
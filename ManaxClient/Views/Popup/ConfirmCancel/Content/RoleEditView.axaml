<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:content="clr-namespace:ManaxClient.ViewModels.Popup.ConfirmCancel.Content"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:localizer="clr-namespace:ManaxClient.Localization.Localizer"
    x:Class="ManaxClient.Views.Popup.ConfirmCancel.Content.RoleEditView"
    x:DataType="content:RoleEditViewModel">
    <StackPanel Orientation="Vertical"
                Spacing="16">
        <StackPanel Classes="popup-title">
            <avalonia:MaterialIcon Classes="icon"
                                   Kind="ClipboardAccountOutline" />
            <StackPanel>
                <TextBlock Text="{localizer:Localize RoleEditPopup.Title}" />
                <TextBlock Text="{localizer:Localize RoleEditPopup.Description}" />
            </StackPanel>
        </StackPanel>

        <Border Classes="input">
            <StackPanel>
                <TextBlock Text="{localizer:Localize RoleEditPopup.Name}" />
                <TextBox Text="{Binding Name}"
                         Watermark="{localizer:Localize RoleEditPopup.Name.Placeholder}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
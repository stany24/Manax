<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:previews="clr-namespace:ManaxClient.Controls.Previews"
    xmlns:page="clr-namespace:ManaxClient.ViewModels.Pages.Library"
    xmlns:viewModels="clr-namespace:ManaxClient.ViewModels"
    xmlns:localization1="clr-namespace:ManaxClient.Localization"
    xmlns:controls="clr-namespace:ManaxClient.Controls"
    xmlns:localizer="clr-namespace:ManaxClient.Localization.Localizer"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="ManaxClient.Views.Pages.Library.LibraryPageView"
    x:DataType="page:LibraryPageViewModel"
    IsVisible="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).PermissionManager.CanReadLibraries}"
    Classes="page">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Vertical" Spacing="24">

            <Border Classes="card">
                <Grid Classes=""
                      ColumnDefinitions="*,Auto"
                      RowDefinitions="Auto,Auto">
                    <StackPanel Grid.Column="0"
                                Grid.Row="0"
                                Orientation="Vertical">
                        <TextBlock Text="{Binding Library.Name}" />
                        <TextBlock
                            Text="{localization1:LocalizeFormat LibraryPage.SeriesCount,
                                   Param1={Binding $parent[UserControl].((page:LibraryPageViewModel)DataContext).Library.Series.Count}}" />
                    </StackPanel>

                    <controls:IconButton Grid.Column="1"
                                         Grid.Row="0"
                                         Classes="icon-button light"
                                         IsVisible="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).PermissionManager.CanDeleteLibraries}"
                                         Command="{Binding DeleteLibrary}"
                                         Text="{localizer:Localize LibraryPage.Delete}"
                                         Icon="DeleteOutline" />
                </Grid>
            </Border>

            <Border Classes="card"
                    IsVisible="{Binding Library.Series.Count}">
                <StackPanel Orientation="Vertical"
                            Spacing="20">
                    <TextBlock Text="{localizer:Localize LibraryPage.LibrarySeries}" />

                    <ItemsControl ItemsSource="{Binding Library.Series}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <previews:SeriePreview
                                    Serie="{Binding .}"
                                    CommandParameter="{Binding .}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemSpacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
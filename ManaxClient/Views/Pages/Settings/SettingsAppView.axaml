<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:page="clr-namespace:ManaxClient.ViewModels.Pages.Settings"
    xmlns:localization="clr-namespace:Jeek.Avalonia.Localization;assembly=Jeek.Avalonia.Localization"
    xmlns:icon="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="ManaxClient.Views.Pages.Settings.SettingsAppView"
    x:DataType="page:SettingsAppViewModel">

    <UserControl.Styles>
        <Style Selector="Grid.title">
            <Setter Property="ColumnSpacing" Value="12"/>
        </Style>
        
        <Style Selector="Grid.title > TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="24"/>
        </Style>
    </UserControl.Styles>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical" Spacing="24">

            <Border Classes="card">
                <Grid Classes="title"
                      ColumnDefinitions="Auto,Auto,*">
                    <icon:MaterialIcon Grid.Column="0"
                                       Classes="icon"
                                       Kind="CogOutline"/>
                    <TextBlock Grid.Column="1"
                               Text="{localization:Localize SettingsAppPage.Title}" />
                </Grid>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="20">
                    <Grid Classes="section-title"
                          ColumnDefinitions="Auto,Auto,*">
                        <icon:MaterialIcon Grid.Column="0"
                                           Classes="icon"
                                           Kind="FlagVariantOutline"/>
                        <TextBlock Grid.Column="1"
                                   Text="{localization:Localize SettingsAppPage.Language}"
                                   Margin="0" />
                    </Grid>

                    <Grid ColumnDefinitions="*" RowDefinitions="Auto" RowSpacing="16">
                        <StackPanel Grid.Column="0" Grid.Row="0" Spacing="6">
                            <TextBlock Text="{localization:Localize SettingsAppPage.SelectedLanguage}"
                                       FontWeight="Medium" />
                            <ComboBox ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding SelectedLanguage}"
                                      DisplayMemberBinding="{Binding DisplayName}"
                                      HorizontalAlignment="Stretch"
                                      MinWidth="200"
                                      Padding="8,6"
                                      CornerRadius="6"
                                      BorderThickness="1" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="20">
                    <Grid Classes="section-title"
                          ColumnDefinitions="Auto,Auto,*">
                        <icon:MaterialIcon Grid.Column="0"
                                           Classes="icon"
                                           Kind="MoonWaxingCrescent"/>
                        <TextBlock Grid.Column="1"
                                   Text="{localization:Localize SettingsAppPage.DisplayMode}"
                                   Margin="0" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto" ColumnSpacing="16" RowSpacing="16">
                        <StackPanel Grid.Column="0" Grid.Row="0" Spacing="6">
                            <TextBlock Text="{localization:Localize SettingsAppPage.DarkMode}" FontWeight="Medium" />
                            <ToggleSwitch IsChecked="{Binding IsDarkMode}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="20">
                    <Grid Classes="section-title"
                          ColumnDefinitions="Auto,Auto,*">
                        <icon:MaterialIcon Grid.Column="0"
                                           Classes="icon"
                                           Kind="PaletteOutline"/>
                        <TextBlock Grid.Column="1"
                                   Text="{localization:Localize SettingsAppPage.AccentColor}"
                                   Margin="0" />
                    </Grid>

                    <ColorView
                        HsvColor="{Binding ThemeColor}">
                    </ColorView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:content="clr-namespace:ManaxClient.ViewModels.Popup.ConfirmCancel.Content"
    xmlns:localization="clr-namespace:Jeek.Avalonia.Localization;assembly=Jeek.Avalonia.Localization"
    xmlns:viewModels="clr-namespace:ManaxClient.ViewModels"
    mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="250"
    x:Class="ManaxClient.Views.Popup.ConfirmCancel.Content.TagEditView"
    x:DataType="content:TagEditViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16" Margin="16">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
            <Image Classes="icon"
                   Source="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).IconManager.TagsIcon}"/>
            <StackPanel Spacing="4">
                <TextBlock
                    Text="{localization:Localize TagEditPopup.Title}"
                    FontSize="18"
                    FontWeight="Bold" />
                <TextBlock
                    Text="{localization:Localize TagEditPopup.Description}"
                    FontSize="12" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock
                Text="{localization:Localize TagEditPopup.Name}"
                FontWeight="Medium" />
            <TextBox
                Text="{Binding Name}"
                Watermark="{localization:Localize TagEditPopup.Name.Placeholder}"
                Padding="12"
                CornerRadius="8"
                BorderThickness="1"
                FontSize="14" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock
                Text="{localization:Localize TagEditPopup.Color}"
                FontWeight="Medium" />
            <ColorPicker
                Color="{Binding Color,Mode=TwoWay}" />
        </StackPanel>
        <Border
            Grid.Row="3"
            HorizontalAlignment="Left"
            CornerRadius="5">
            <TextBlock
                Margin="5"
                Text="{Binding Name}" />
        </Border>

    </Grid>
</UserControl>
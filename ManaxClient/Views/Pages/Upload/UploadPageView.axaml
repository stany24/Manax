<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tag="clr-namespace:ManaxClient.ViewModels.Pages.Upload"
    xmlns:viewModels="clr-namespace:ManaxClient.ViewModels"
    x:Class="ManaxClient.Views.Pages.Upload.UploadPageView"
    x:DataType="tag:UploadPageViewModel"
    IsVisible="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).PermissionManager.CanUploadChapter}">

    <ContentControl
        Content="{Binding SelectedTabViewModel}" />

</UserControl>
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:previews="clr-namespace:ManaxClient.Controls.Previews"
    xmlns:page="clr-namespace:ManaxClient.ViewModels.Pages.Home"
    xmlns:viewModels="clr-namespace:ManaxClient.ViewModels"
    xmlns:localization="clr-namespace:Jeek.Avalonia.Localization;assembly=Jeek.Avalonia.Localization"
    xmlns:localization1="clr-namespace:ManaxClient.Localization"
    xmlns:controls="clr-namespace:ManaxClient.Controls"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="ManaxClient.Views.Pages.Home.HomePageView"
    x:DataType="page:HomePageViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical" Spacing="24">

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Classes="title" Text="{localization:Localize HomePage.Welcome}" />
                    <TextBlock Classes="subtitle"
                               Text="{localization:Localize HomePage.Subtitle}" />
                </StackPanel>

                <controls:IconButton Grid.Column="1"
                        IsVisible="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).PermissionManager.CanWriteSeries}"
                        Command="{Binding UploadSerie}"
                        Text="{localization:Localize HomePage.AddSeries}"
                        Icon="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).IconManager.AddIcon}"/>
            </Grid>

            <Border Classes="card" IsVisible="{Binding !Series.Count}">
                <StackPanel Orientation="Vertical"
                            Spacing="16"
                            HorizontalAlignment="Center">
                    <TextBlock Text="{localization:Localize HomePage.NoSeries}"
                               FontSize="18"
                               FontWeight="Medium"
                               HorizontalAlignment="Center" />
                    <TextBlock
                        Text="{localization:Localize HomePage.NoSeries.Description}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        MaxWidth="400" />
                    <controls:IconButton IsVisible="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).PermissionManager.CanWriteSeries}"
                            Command="{Binding UploadSerie}"
                            Text="{localization:Localize HomePage.AddFirstSeries}"
                            Icon="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).IconManager.AddIcon}"/>
                </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding Series.Count}">
                <StackPanel Orientation="Vertical" Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Classes="subtitle"
                                   Text="{localization:Localize HomePage.RecentSeries}"
                                   Margin="0" />
                        <TextBlock Grid.Column="1"
                                   Text="{localization1:LocalizeFormat HomePage.SeriesCount,
                                       Param1={Binding $parent[UserControl].((page:HomePageViewModel)DataContext).Series.Count}}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Series}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent"
                                            Padding="8"
                                            CornerRadius="12"
                                            Margin="4">
                                        <previews:SeriePreview
                                            Serie="{Binding .}"
                                            BackGroundColor="{DynamicResource MaterialCardBackgroundBrush}"
                                            CommandParameter="{Binding .}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
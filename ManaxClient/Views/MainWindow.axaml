<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ManaxClient.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:localization="clr-namespace:Jeek.Avalonia.Localization;assembly=Jeek.Avalonia.Localization"
    xmlns:converters="clr-namespace:ManaxClient.Converters"
    xmlns:controls="clr-namespace:ManaxClient.Controls"
    mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
    x:Class="ManaxClient.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/avalonia-logo.ico"
    Title="{localization:Localize MainWindow.Title}"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:IssuePageVisibleConverter x:Key="IssuePageVisibleConverter" />
    </Window.Resources>
    
    <Window.Styles>
        <Style Selector="StackPanel.sidebar">
            <Setter Property="Background" Value="{DynamicResource MaterialCardBackgroundBrush}"/>
        </Style>
        
        <Style Selector="StackPanel.sidebar > controls|IconButton">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="4,4,12,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="{DynamicResource MaterialCardBackgroundBrush}"/>
            <Setter Property="IconColor" Value="{DynamicResource MaterialPrimaryMidBrush}"/>
        </Style>
        
        <Style Selector="StackPanel.sidebar > controls|IconButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource MaterialPaperBrush}"/>
        </Style>
        
        <Style Selector="StackPanel.sidebar > TextBlock">
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="12,12,12,0"/>
        </Style>
    </Window.Styles>

    <Panel>
        <Grid ColumnDefinitions="Auto,*">
            <ScrollViewer Grid.Column="0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Hidden"
                          Background="{DynamicResource MaterialCardBackgroundBrush}">
                <StackPanel Classes="sidebar"
                            IsVisible="{Binding CurrentPageViewModel.ControlBarVisible}"
                            Orientation="Vertical">

                    <TextBlock Text="{localization:Localize MainWindow.Title}"
                               HorizontalAlignment="Center"/>

                    <controls:IconButton Command="{Binding ChangePageHome}"
                                         Icon="HomeOutline"
                                         Text="{localization:Localize MainWindow.Home}"/>

                    <TextBlock IsVisible="{Binding Libraries.Count}"
                               Text="{localization:Localize MainWindow.Libraries}"/>

                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Libraries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:IconButton Background="Transparent"
                                                         Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowLibrary}"
                                                         CommandParameter="{Binding }"
                                                         Icon="Bookshelf"
                                                         Text="{Binding Name}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="{localization:Localize MainWindow.Admin}"
                               IsVisible="{Binding IsAdmin}" />

                    <controls:IconButton Command="{Binding ChangePageIssues}"
                                         Icon="WarningOutline"
                                         Text="{localization:Localize MainWindow.Issues}">
                        <controls:IconButton.IsVisible>
                            <MultiBinding Converter="{StaticResource  IssuePageVisibleConverter}">
                                <Binding Path="FeatureManager.AutomaticIssuesFeatureEnabled" />
                                <Binding Path="FeatureManager.ReportedIssuesFeatureEnabled" />
                                <Binding Path="PermissionManager.CanReadAllIssues" />
                            </MultiBinding>
                        </controls:IconButton.IsVisible>
                    </controls:IconButton>

                    <controls:IconButton IsVisible="{Binding PermissionManager.CanReadUsers}"
                                         Command="{Binding ChangePageUsers}"
                                         Icon="AccountGroupOutline"
                                         Text="{localization:Localize MainWindow.Users}"/>

                    <controls:IconButton Command="{Binding ChangePageRanks}"
                                         Icon="ChevronTripleUp"
                                         Text="{localization:Localize MainWindow.Ranks}">
                        <controls:IconButton.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="FeatureManager.RankFeatureEnabled" />
                                <Binding Path="PermissionManager.CanReadRanks" />
                            </MultiBinding>
                        </controls:IconButton.IsVisible>
                    </controls:IconButton>
                    
                    <controls:IconButton IsVisible="{Binding PermissionManager.CanReadTags}"
                                         Command="{Binding ChangePageTags}"
                                         Icon="TagOutline"
                                         Text="{localization:Localize MainWindow.Tags}"/>

                    <controls:IconButton IsVisible="{Binding PermissionManager.CanUploadChapter}"
                                         Command="{Binding ChangeUploadPage}"
                                         Icon="UploadOutline"
                                         Text="{localization:Localize MainWindow.Upload}"/>

                    <controls:IconButton IsVisible="{Binding PermissionManager.CanReadPersons}"
                                         Command="{Binding ChangePagePersons}"
                                         Icon="AccountGroupOutline"
                                         Text="{localization:Localize MainWindow.Persons}"/>

                    <TextBlock Text="{localization:Localize MainWindow.Parameters}"/>

                    <controls:IconButton IsVisible="{Binding PermissionManager.CanReadServerSettings}"
                                         Command="{Binding ChangePageSettings}"
                                         Icon="CogOutline"
                                         Text="{localization:Localize MainWindow.Parameters.Server}"/>

                    <controls:IconButton Command="{Binding ChangePageAppSettings}"
                                         Icon="CogOutline"
                                         Text="{localization:Localize MainWindow.Parameters.UI}"/>

                    <controls:IconButton IsVisible="{Binding PermissionManager.CanReadFeatures}"
                                         Command="{Binding ChangePageFeatures}"
                                         Icon="Feather"
                                         Text="{localization:Localize MainWindow.Parameters.Features}"/>

                    <TextBlock Text="{localization:Localize MainWindow.Stats}"/>

                    <controls:IconButton Command="{Binding ChangePageUserStats}"
                                         Icon="ChartLine"
                                         Text="{localization:Localize MainWindow.Stats.User}"/>

                    <controls:IconButton IsVisible="{Binding PermissionManager.CanReadServerStats}"
                                         Command="{Binding ChangePageServerStats}"
                                         Icon="ChartLine"
                                         Text="{localization:Localize MainWindow.Stats.Server}"/>

                    <controls:IconButton Command="{Binding Logout}"
                                         Icon="Logout"
                                         Text="{localization:Localize MainWindow.Logout}"/>

                    <Border Margin="8,16,8,8"
                            IsVisible="{Binding RunningTasks.Count}">
                        <StackPanel>
                            <TextBlock                                        Text="{localization:Localize MainWindow.RunningTasks}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,12" />

                            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding RunningTasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding TaskName}"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center" />
                                                    <Border Grid.Column="1"
                                                            CornerRadius="12"
                                                            Padding="8,4"
                                                            Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Number}"
                                                                   FontSize="12"
                                                                   FontWeight="Bold" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentPageViewModel}" />
        </Grid>

        <ContentControl HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        MaxHeight="{Binding $parent[Window].Height}"
                        MaxWidth="{Binding $parent[Window].Width}"
                        Content="{Binding Popup}"/>

        <StackPanel Orientation="Vertical"
                    Spacing="8"
                    Margin="24"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
            <ItemsControl ItemsSource="{Binding Infos}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border>
                            <Border Background="{DynamicResource MaterialCardBackgroundBrush}"
                                    CornerRadius="5"
                                    BorderThickness="2"
                                    BorderBrush="{DynamicResource MaterialPrimaryMidBrush}">
                                <TextBlock Text="{Binding .}"
                                           Padding="5"
                                           Background="{DynamicResource MaterialCardBackgroundBrush}"
                                           FontWeight="Medium" />
                            </Border>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Panel>
</Window>
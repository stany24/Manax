<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:content="clr-namespace:ManaxClient.ViewModels.Popup.ConfirmCancel.Content"
    xmlns:localization="clr-namespace:Jeek.Avalonia.Localization;assembly=Jeek.Avalonia.Localization"
    xmlns:icon="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
    x:Class="ManaxClient.Views.Popup.ConfirmCancel.Content.LibraryCreateView"
    x:DataType="content:LibraryCreateViewModel">
    <StackPanel Spacing="16">
        <StackPanel Classes="popup-title">
            <icon:MaterialIcon Classes="icon"
                               Kind="BookOpenVariantOutline"/>
            <StackPanel>
                <TextBlock Text="{localization:Localize LibraryCreatePopup.NewLibrary}"/>
                <TextBlock Text="{localization:Localize LibraryCreatePopup.Description}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock
                Text="{localization:Localize LibraryCreatePopup.Name}"
                FontWeight="Medium" />
            <TextBox
                Text="{Binding Name}"
                Watermark="{localization:Localize LibraryCreatePopup.Name.Placeholder}"
                Padding="12"
                CornerRadius="8"
                BorderThickness="1"
                FontSize="14" />
        </StackPanel>

        <Border BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <icon:MaterialIcon Classes="icon"
                                   Kind="Lightbulb"/>
                <TextBlock
                    Text="{localization:Localize LibraryCreatePopup.Info}"
                    TextWrapping="Wrap"
                    FontSize="12" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
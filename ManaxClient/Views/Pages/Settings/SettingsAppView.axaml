<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:page="clr-namespace:ManaxClient.ViewModels.Pages.Settings"
    xmlns:localization="clr-namespace:Jeek.Avalonia.Localization;assembly=Jeek.Avalonia.Localization"
    xmlns:icon="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:controls="clr-namespace:ManaxClient.Controls"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="ManaxClient.Views.Pages.Settings.SettingsAppView"
    x:DataType="page:SettingsAppViewModel"
    Classes="page">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical" Spacing="24">

            <Border Classes="card">
                <Grid Classes="title"
                      ColumnDefinitions="Auto,Auto,*">
                    <icon:MaterialIcon Grid.Column="0"
                                       Classes="icon"
                                       Kind="CogOutline"/>
                    <TextBlock Grid.Column="1"
                               Text="{localization:Localize SettingsAppPage.Title}" />
                </Grid>
            </Border>
            
            <controls:StretchWrapPanel ItemSpacing="12"
                                       LineSpacing="12">
                <Border Classes="card">
                    <StackPanel Spacing="20">
                        <Grid Classes="section-title"
                              ColumnDefinitions="Auto,Auto,*">
                            <icon:MaterialIcon Grid.Column="0"
                                               Classes="icon"
                                               Kind="FlagVariantOutline"/>
                            <TextBlock Grid.Column="1"
                                       Text="{localization:Localize SettingsAppPage.Language}"
                                       Margin="0" />
                        </Grid>

                        <Border Classes="item-card">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{localization:Localize SettingsAppPage.SelectedLanguage}"
                                           FontWeight="Medium" />
                                <ComboBox ItemsSource="{Binding Languages}"
                                          SelectedItem="{Binding SelectedLanguage}"
                                          DisplayMemberBinding="{Binding DisplayName}"
                                          HorizontalAlignment="Stretch"
                                          MinWidth="200"
                                          Padding="8,6"
                                          CornerRadius="6"
                                          BorderThickness="1" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="20">
                        <Grid Classes="section-title"
                              ColumnDefinitions="Auto,Auto,*">
                            <icon:MaterialIcon Grid.Column="0"
                                               Classes="icon"
                                               Kind="MoonWaxingCrescent"/>
                            <TextBlock Grid.Column="1"
                                       Text="{localization:Localize SettingsAppPage.DisplayMode}"
                                       Margin="0" />
                        </Grid>

                        <Border Classes="item-card">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{localization:Localize SettingsAppPage.DarkMode}"
                                           FontWeight="Medium" />
                                <ToggleSwitch IsChecked="{Binding IsDarkMode}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="20">
                        <Grid Classes="section-title"
                              ColumnDefinitions="Auto,Auto,*">
                            <icon:MaterialIcon Grid.Column="0"
                                               Classes="icon"
                                               Kind="PaletteOutline"/>
                            <TextBlock Grid.Column="1"
                                       Text="{localization:Localize SettingsAppPage.AccentColor}"
                                       Margin="0" />
                        </Grid>

                        <Border Classes="item-card">
                            <ColorView
                                HsvColor="{Binding ThemeColor}">
                            </ColorView>
                        </Border>
                    </StackPanel>
                </Border>
            </controls:StretchWrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
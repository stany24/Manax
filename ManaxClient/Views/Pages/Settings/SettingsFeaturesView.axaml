<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:page="clr-namespace:ManaxClient.ViewModels.Pages.Settings"
    xmlns:viewModels="clr-namespace:ManaxClient.ViewModels"
    xmlns:localization="clr-namespace:Jeek.Avalonia.Localization;assembly=Jeek.Avalonia.Localization"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
    x:Class="ManaxClient.Views.Pages.Settings.SettingsFeaturesView"
    x:DataType="page:SettingsFeaturesViewModel"
    IsVisible="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).CanReadFeatures}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical" Spacing="24" MaxWidth="800">

            <StackPanel Orientation="Vertical">
                <TextBlock Classes="title" Text="{localization:Localize SettingsFeaturesPage.Title}" />
                <TextBlock Text="{localization:Localize SettingsFeaturesPage.Subtitle}"/>
            </StackPanel>

            <!-- Success/Error Messages -->
            <Border Classes="card"
                    IsVisible="{Binding Success, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="✅" FontSize="20" />
                    <TextBlock Text="{Binding Success}"
                               FontWeight="Medium" />
                </StackPanel>
            </Border>

            <Border Classes="card"
                    IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="❌" FontSize="20" />
                    <TextBlock Text="{Binding Problem}" 
                               FontWeight="Medium" />
                </StackPanel>
            </Border>

            <!-- Save Button -->
            <Border Classes="card">
                <Button Classes="primary"
                        IsVisible="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).CanWriteFeatures}"
                        Command="{Binding SaveFeatures}"
                        Padding="24,12"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="💾" />
                        <TextBlock Text="{localization:Localize SettingsFeaturesPage.Save}" FontWeight="Medium" />
                    </StackPanel>
                </Button>
            </Border>

            <!-- Features List -->
            <ItemsControl ItemsSource="{Binding Features}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="card" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                
                                <!-- Feature Name -->
                                <TextBlock Grid.Column="0" Grid.Row="0"
                                           Text="{Binding Name}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />

                                <!-- Toggle Switch -->
                                <ToggleSwitch Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                                              IsChecked="{Binding Value}"
                                              VerticalAlignment="Center"
                                              Margin="16,0,0,0" />

                                <!-- Feature Description -->
                                <TextBlock Grid.Column="0" Grid.Row="1"
                                           Text="{Binding Description}"
                                           TextWrapping="Wrap"
                                           FontSize="14" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>


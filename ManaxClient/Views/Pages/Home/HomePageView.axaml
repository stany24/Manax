<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:previews="clr-namespace:ManaxClient.Controls.Previews"
    xmlns:page="clr-namespace:ManaxClient.ViewModels.Pages.Home"
    xmlns:viewModels="clr-namespace:ManaxClient.ViewModels"
    xmlns:localization="clr-namespace:Jeek.Avalonia.Localization;assembly=Jeek.Avalonia.Localization"
    xmlns:controls="clr-namespace:ManaxClient.Controls"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="ManaxClient.Views.Pages.Home.HomePageView"
    x:DataType="page:HomePageViewModel">
    
    <UserControl.Styles>
        <Style Selector="StackPanel.topbar">
            <Setter Property="Background" Value="{DynamicResource MaterialCardBackgroundBrush}"/>
        </Style>
        
        <Style Selector="TextBox.search">
            <Setter Property="Margin" Value="7,0"/>
        </Style>
        
        <Style Selector="TextBlock.title">
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        
        <Style Selector="TextBlock.description">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical" Spacing="24">

            <Grid Classes="topbar"
                  ColumnDefinitions="Auto,*,Auto">
                <avalonia:MaterialIcon Grid.Column="0"
                                       Kind="Search"/>
                <TextBox Grid.Column="1"
                         Classes="search"
                         Text="Future search area"/>
                <controls:IconButton Classes="icon-button dark"
                                     Grid.Column="2"
                                     IsVisible="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).PermissionManager.CanWriteSeries}"
                                     Command="{Binding UploadSerie}"
                                     Text="{localization:Localize HomePage.AddSeries}"
                                     Icon="Add"/>
            </Grid>

            <Border Classes="card"
                    IsVisible="{Binding !Series.Count}">
                <StackPanel>
                    <TextBlock Classes="title"
                               Text="{localization:Localize HomePage.NoSeries}" />
                    <TextBlock Classes="description"
                               Text="{localization:Localize HomePage.NoSeries.Description}"/>
                    <controls:IconButton Classes="icon-button light"
                                         IsVisible="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).PermissionManager.CanWriteSeries}"
                                         Command="{Binding UploadSerie}"
                                         Text="{localization:Localize HomePage.AddFirstSeries}"
                                         Icon="Add"/>
                </StackPanel>
            </Border>
            
            <Border Classes="card"
                    IsVisible="{Binding Series.Count}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Classes="section-title"
                               Text="{localization:Localize HomePage.RecentSeries}"/>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Series}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border>
                                        <previews:SeriePreview
                                            Serie="{Binding .}"
                                            BackGroundColor="{DynamicResource MaterialBackgroundBrush}"
                                            CommandParameter="{Binding .}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
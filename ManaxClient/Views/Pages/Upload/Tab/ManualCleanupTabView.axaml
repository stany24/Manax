<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:ManaxClient.ViewModels"
    xmlns:tab="clr-namespace:ManaxClient.ViewModels.Pages.Upload.Tab"
    xmlns:upload="clr-namespace:ManaxClient.Models.Upload"
    xmlns:localization="clr-namespace:Jeek.Avalonia.Localization;assembly=Jeek.Avalonia.Localization"
    xmlns:controls="clr-namespace:ManaxClient.Controls"
    mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="600"
    x:Class="ManaxClient.Views.Pages.Upload.Tab.ManualCleanupTabView"
    x:DataType="tab:ManualCleanupTabViewModel"
    IsVisible="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).CanUploadChapter}">
    <Grid ColumnDefinitions="200,*,200" RowDefinitions="*" Margin="8">
        
        <!-- Left Panel: Serie Folders with Chapters -->
        <Border Grid.Column="0" Grid.Row="0" Classes="card" Margin="0,0,4,0">
            <StackPanel Orientation="Vertical" Spacing="8">
                <TextBlock Text="{localization:Localize ManualCleanupPage.SerieFolders}" 
                           FontWeight="SemiBold" 
                           FontSize="14"
                           Margin="8,8,8,0"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SerieFolders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="upload:SerieFolder">
                                <StackPanel Orientation="Vertical" Spacing="2">
                                    <!-- Serie Header -->
                                    <TextBlock Text="{Binding Name}" 
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Margin="8,8,8,4"/>
                                    
                                    <!-- Chapter List -->
                                    <ItemsControl ItemsSource="{Binding Chapters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="upload:ChapterFolder">
                                                <Button Classes="sidebar"
                                                        Command="{Binding $parent[UserControl].((tab:ManualCleanupTabViewModel)DataContext).SetSelectedChapterFolder}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Stretch"
                                                        Padding="16,6"
                                                        Margin="8,0,0,0">
                                                    <StackPanel Orientation="Vertical" Spacing="2">
                                                        <TextBlock Text="{Binding Name}" 
                                                                   TextWrapping="Wrap"
                                                                   FontWeight="Medium"
                                                                   FontSize="12"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="📷" FontSize="10"/>
                                                            <TextBlock Text="{Binding Images.Count}" 
                                                                       FontSize="11"
                                                                       Opacity="0.7"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
        
        <!-- Middle Panel: Images in Selected Chapter -->
        <Border Grid.Column="1" Grid.Row="0" Classes="card" Margin="4,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8,8,8,8">
                    <TextBlock Text="{localization:Localize ManualCleanupPage.Images}" 
                               FontWeight="SemiBold" 
                               FontSize="14"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedChapterFolder.Name}" 
                               Opacity="0.7"
                               VerticalAlignment="Center"
                               IsVisible="{Binding SelectedChapterFolder, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Offset="{Binding ImagesOffset, Mode=TwoWay}">
                    <ItemsControl ItemsSource="{Binding SelectedChapterFolder.Images}"
                                  VerticalAlignment="Top">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="4" 
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        ClipToBounds="True"
                                        Cursor="Hand">
                                    <Button Classes="sidebar"
                                            Background="Transparent"
                                            PointerPressed="PointerPressedHandler"
                                            Command="{Binding $parent[UserControl].((tab:ManualCleanupTabViewModel)DataContext).AddImageToEdit}"
                                            CommandParameter="{Binding Path}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="0">
                                        <StackPanel Orientation="Vertical" Spacing="4">
                                            <Image Source="{Binding Preview}"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding FileName}"
                                                       FontSize="10"
                                                       Opacity="0.7"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="4"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:BestFitGrid Columns="{Binding $parent[UserControl].((tab:ManualCleanupTabViewModel)DataContext).NbColumns}"
                                             VerticalAlignment="Top" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
        
        <!-- Right Panel: Images to Edit -->
        <Border Grid.Column="2" Grid.Row="0" Classes="card" Margin="4,0,0,0">
            <Grid RowDefinitions="Auto,*,Auto">
                <TextBlock Grid.Row="0" 
                           Text="{localization:Localize ManualCleanupPage.ToEdit}" 
                           FontWeight="SemiBold" 
                           FontSize="14"
                           Margin="8,8,8,0"/>
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ImagesToEdit}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Margin="4" 
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        ClipToBounds="True">
                                    <StackPanel Orientation="Vertical" Spacing="4">
                                        <Image Source="{Binding}"
                                               Stretch="Uniform"
                                               MaxHeight="150"
                                               HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding}"
                                                   FontSize="10"
                                                   Opacity="0.7"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="4"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="2">
                    <Button
                        Content="{localization:Localize ManualCleanupPage.EditSelected}"
                        Command="{Binding Edit}"></Button>
                    <Button
                        Content="{localization:Localize ManualCleanupPage.Next}"
                        Command="{Binding Next}"></Button>
                    <Button
                        Content="{localization:Localize ManualCleanupPage.RestoreLastImage}"
                        IsVisible="False"
                        Command="{Binding SelectedChapterFolder.RestoreLastImage}"
                        HotKey="Ctrl+z"></Button>
                    <Button
                        Content="{localization:Localize ManualCleanupPage.RestoreLastImage}"
                        IsVisible="False"
                        Command="{Binding NextChapter}"
                        HotKey="Right"></Button>
                    <Button
                        IsVisible="False"
                        Command="{Binding PreviousChapter}"
                        HotKey="Left"></Button>
                    <Button
                        IsVisible="False"
                        Command="{Binding MoveDown}"
                        HotKey="Down"></Button>
                    <Button
                        IsVisible="False"
                        Command="{Binding MoveUp}"
                        HotKey="Up"></Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
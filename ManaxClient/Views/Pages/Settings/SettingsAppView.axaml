<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:page="clr-namespace:ManaxClient.ViewModels.Pages.Settings"
    xmlns:icon="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:controls="clr-namespace:ManaxClient.Controls"
    xmlns:localizer="clr-namespace:ManaxClient.Localization.Localizer"
    x:Class="ManaxClient.Views.Pages.Settings.SettingsAppView"
    x:DataType="page:SettingsAppViewModel"
    Classes="page">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical" Spacing="24">

            <Border Classes="card">
                <Grid Classes="title"
                      ColumnDefinitions="Auto,Auto,*">
                    <icon:MaterialIcon Grid.Column="0"
                                       Classes="icon"
                                       Kind="CogOutline" />
                    <TextBlock Grid.Column="1"
                               Text="{localizer:Localize SettingsAppPage.Title}" />
                </Grid>
            </Border>

            <controls:StretchWrapPanel ItemSpacing="12"
                                       LineSpacing="12">
                <Border Classes="card">
                    <StackPanel Spacing="20">
                        <Grid Classes="section-title"
                              ColumnDefinitions="Auto,Auto">
                            <icon:MaterialIcon Grid.Column="0"
                                               Classes="icon"
                                               Kind="FlagVariantOutline" />
                            <TextBlock Grid.Column="1"
                                       Text="{localizer:Localize SettingsAppPage.Language}"
                                       Margin="0" />
                        </Grid>

                        <Border Classes="item-card">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{localizer:Localize SettingsAppPage.SelectedLanguage}"
                                           FontWeight="Medium" />
                                <ComboBox ItemsSource="{Binding Languages}"
                                          SelectedItem="{Binding SelectedLanguage}"
                                          DisplayMemberBinding="{Binding DisplayName}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="20">
                        <Grid Classes="section-title"
                              ColumnDefinitions="Auto,Auto,*">
                            <icon:MaterialIcon Grid.Column="0"
                                               Classes="icon"
                                               Kind="MoonWaxingCrescent" />
                            <TextBlock Grid.Column="1"
                                       Text="{localizer:Localize SettingsAppPage.DisplayMode}"
                                       Margin="0" />
                        </Grid>

                        <Border Classes="item-card">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{localizer:Localize SettingsAppPage.DarkMode}"
                                           FontWeight="Medium" />
                                <ToggleSwitch IsChecked="{Binding IsDarkMode}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="20">
                        <Grid Classes="section-title"
                              ColumnDefinitions="Auto,Auto,*">
                            <icon:MaterialIcon Grid.Column="0"
                                               Classes="icon"
                                               Kind="PaletteOutline" />
                            <TextBlock Grid.Column="1"
                                       Text="{localizer:Localize SettingsAppPage.AccentColor}"
                                       Margin="0" />
                        </Grid>

                        <Border Classes="item-card">
                            <ColorView
                                HsvColor="{Binding ThemeColor}" />
                        </Border>
                    </StackPanel>
                </Border>
            </controls:StretchWrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
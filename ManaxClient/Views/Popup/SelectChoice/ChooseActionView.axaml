<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:selectChoice="clr-namespace:ManaxClient.ViewModels.Popup.SelectChoice"
    x:Class="ManaxClient.Views.Popup.SelectChoice.ChooseActionView"
    x:DataType="selectChoice:ChooseActionViewModel"
    Background="{DynamicResource MaterialCardBackgroundBrush}"
    CornerRadius="5">

    <StackPanel Spacing="16" Margin="16">
        <TextBlock
            Text="Actions"
            FontSize="16"
            FontWeight="Bold"
            HorizontalAlignment="Center" />

        <ItemsControl ItemsSource="{Binding Options}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button
                        Content="{Binding}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        BorderThickness="0"
                        Padding="12,8"
                        Command="{Binding $parent[UserControl].((selectChoice:ChooseActionViewModel)DataContext).SelectAction}"
                        CommandParameter="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
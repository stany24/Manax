<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:previews="clr-namespace:ManaxClient.Controls.Previews"
    xmlns:page="clr-namespace:ManaxClient.ViewModels.Pages.Serie"
    xmlns:viewModels="clr-namespace:ManaxClient.ViewModels"
    xmlns:localization="clr-namespace:Jeek.Avalonia.Localization;assembly=Jeek.Avalonia.Localization"
    xmlns:localization1="clr-namespace:ManaxClient.Localization"
    xmlns:converters="clr-namespace:ManaxClient.Converters"
    xmlns:data="clr-namespace:ManaxClient.Models.Server.Data"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="ManaxClient.Views.Pages.Serie.SeriePageView"
    x:DataType="page:SeriePageViewModel">

    <UserControl.Resources>
        <converters:ColorToSolidBrushConverter x:Key="ColorToBrushConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <Border Grid.Column="0" >
                <StackPanel Width="180">
                    <TextBlock Classes="title" Text="{Binding Serie.Title}" />
                    
                    <Border CornerRadius="12" ClipToBounds="True">
                        <Image Source="{Binding Serie.Poster}"
                               Stretch="UniformToFill" />
                    </Border>

                    <Border>
                        <TextBlock Text="{Binding Serie.Description}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <StackPanel
                        Orientation="Horizontal">
                        <Button Classes="secondary"
                                IsVisible="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).PermissionManager.CanWriteSeries}"
                                Command="{Binding ReplacePoster}"
                                IsEnabled="{Binding !IsFilePickerOpen}"
                                HorizontalAlignment="Stretch">
                            <TextBlock Text="🖼️" />
                        </Button>

                        <Button Classes="secondary"
                                IsVisible="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).PermissionManager.CanWriteSeries}"
                                Command="{Binding UpdateSerie}"
                                IsEnabled="{Binding !IsFilePickerOpen}"
                                HorizontalAlignment="Stretch">
                            <TextBlock Text="{localization:Localize SeriePage.ChangeButton}" />
                        </Button>
                    </StackPanel>

                    <StackPanel Spacing="8" 
                                IsVisible="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).FeatureManager.RankFeatureEnabled}">
                        <TextBlock Text="{localization:Localize SeriePage.SerieRating}" FontWeight="Medium" />
                        <ComboBox ItemsSource="{Binding Ranks}"
                                  SelectedItem="{Binding SelectedRank}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="data:Rank">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border CornerRadius="12"
                                Padding="8,4"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Serie.Status}"
                                       FontSize="12"
                                       FontWeight="Medium" />
                        </Border>

                        <TextBlock
                            Text="{localization1:LocalizeFormat SeriePage.ChapterCount,
                                           Param1={Binding $parent[UserControl].((page:SeriePageViewModel)DataContext).Serie.Chapters.Count}}" />
                    </StackPanel>
                    
                    <Border IsVisible="{Binding Serie.Tags.Count}">
                        <StackPanel>
                            <TextBlock Classes="subtitle" Text="{localization:Localize SeriePage.Tags}" Margin="0" />

                            <ItemsControl ItemsSource="{Binding Serie.Tags}"
                                          IsVisible="{Binding Serie.Tags.Count}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            BorderBrush="{Binding Color, Converter={StaticResource ColorToBrushConverter}}"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Margin="2"
                                            Padding="6,3">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="Medium" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding Serie.Persons.Count}">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="subtitle" Text="{localization:Localize SeriePage.Persons}" Margin="0" />
                            <ItemsControl ItemsSource="{Binding Serie.Persons}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="2"
                                                CornerRadius="16"
                                                Margin="4"
                                                Padding="12,6">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding FullName}"
                                                           FontSize="13"
                                                           FontWeight="Medium" />
                                                <TextBlock Text="{Binding Role.Name}"
                                                           FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="card">
                <StackPanel Spacing="16">
                    <TextBlock Classes="subtitle" Text="{localization:Localize SeriePage.Chapters}" Margin="0" />

                    <Border CornerRadius="8"
                            Padding="12"
                            IsVisible="{Binding !Serie.Chapters.Count}">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="📖" FontSize="32" />
                            <Image Classes="icon"
                                   Source="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).IconManager.BookIcon}"/>
                            <TextBlock Text="{localization:Localize SeriePage.NoChaptersAvailable}"
                                       FontWeight="Medium" />
                            <TextBlock Text="{localization:Localize SeriePage.NoChaptersDescription}"
                                       FontSize="12" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Serie.Chapters}"
                                  IsVisible="{Binding Serie.Chapters.Count}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent"
                                        Padding="8"
                                        CornerRadius="8"
                                        Margin="0,2">
                                    <previews:ChapterPreview
                                        Chapter="{Binding .}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
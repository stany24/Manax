<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:content="clr-namespace:ManaxClient.ViewModels.Popup.ConfirmCancel.Content"
    xmlns:localization="clr-namespace:Jeek.Avalonia.Localization;assembly=Jeek.Avalonia.Localization"
    xmlns:icon="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
    x:Class="ManaxClient.Views.Popup.ConfirmCancel.Content.LibraryCreateView"
    x:DataType="content:LibraryCreateViewModel">
    <StackPanel Spacing="16">
        <StackPanel Classes="popup-title">
            <icon:MaterialIcon Classes="icon"
                               Kind="LibraryShelves" />
            <StackPanel>
                <TextBlock Text="{localization:Localize LibraryCreatePopup.NewLibrary}" />
                <TextBlock Text="{localization:Localize LibraryCreatePopup.Description}" />
            </StackPanel>
        </StackPanel>

        <Border Classes="input">
            <StackPanel>
                <TextBlock Text="{localization:Localize LibraryCreatePopup.Name}" />
                <TextBox Text="{Binding Name}"
                         PlaceholderText="{localization:Localize LibraryCreatePopup.Name.Placeholder}" />
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="8">
            <icon:MaterialIcon Grid.Column="0"
                               Classes="icon"
                               Kind="Lightbulb" />
            <TextBlock Grid.Column="1"
                       Text="{localization:Localize LibraryCreatePopup.Info}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </Grid>
    </StackPanel>
</UserControl>
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:avalonia="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
    xmlns:previews="clr-namespace:ManaxClient.Controls.Previews"
    xmlns:page="clr-namespace:ManaxClient.ViewModels.Pages.Stats"
    xmlns:viewModels="clr-namespace:ManaxClient.ViewModels"
    xmlns:localization="clr-namespace:Jeek.Avalonia.Localization;assembly=Jeek.Avalonia.Localization"
    xmlns:icon="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:controls="clr-namespace:ManaxClient.Controls"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="ManaxClient.Views.Pages.Stats.ServerStatsPageView"
    x:DataType="page:ServerStatsPageViewModel"
    IsVisible="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).PermissionManager.CanReadServerStats}"
    Classes="page">

    <UserControl.Styles>
        <Style Selector="avalonia|CartesianChart.chart">
            <Setter Property="Background" Value="{DynamicResource MaterialCardBackgroundBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Height" Value="300" />
            <Setter Property="MinWidth" Value="400" />
        </Style>

        <Style Selector="avalonia|PieChart.chart">
            <Setter Property="Background" Value="{DynamicResource MaterialCardBackgroundBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Height" Value="300" />
            <Setter Property="MinWidth" Value="300" />
        </Style>

        <Style Selector="TextBlock.name">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.number">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical" Spacing="24">


            <Border Classes="card">
                <Grid Classes="title"
                      ColumnDefinitions="Auto,Auto,*">
                    <icon:MaterialIcon Grid.Column="0"
                                       Classes="icon"
                                       Kind="ChartLine" />
                    <TextBlock Grid.Column="1"
                               Text="{localization:Localize ServerStatsPage.Title}" />
                </Grid>
            </Border>

            <controls:StretchWrapPanel ItemSpacing="12"
                                       LineSpacing="12">
                <Border Classes="card">
                    <StackPanel Spacing="20">
                        <Grid Classes="section-title"
                              ColumnDefinitions="Auto,Auto,*">
                            <TextBlock Grid.Column="0"
                                       Text="💾" />
                            <TextBlock Grid.Column="1"
                                       Text="{localization:Localize ServerStatsPage.DiskUsage.Title}" />
                        </Grid>

                        <avalonia:PieChart Classes="chart"
                                           Series="{Binding DiskUsageSeries}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Border Classes="item-card"
                                    Grid.Column="0">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="name"
                                               Text="{localization:Localize ServerStatsPage.DiskUsage.Used}"
                                               FontSize="12" />
                                    <TextBlock Classes="number"
                                               Text="{Binding DiskSizeInGb, StringFormat={}{0:F1} GB}" />
                                </StackPanel>
                            </Border>

                            <Border Classes="item-card"
                                    Grid.Column="1">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="name"
                                               Text="{localization:Localize ServerStatsPage.DiskUsage.Available}" />
                                    <TextBlock Classes="number"
                                               Text="{Binding AvailableDiskSizeInGb, StringFormat={}{0:F1} GB}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="20">
                        <Grid Classes="section-title"
                              ColumnDefinitions="Auto,Auto,*">
                            <icon:MaterialIcon Grid.Column="0"
                                               Classes="icon"
                                               Kind="AccountGroupOutline" />
                            <TextBlock Grid.Column="1"
                                       Text="{localization:Localize ServerStatsPage.UserActivity.Title}" />
                        </Grid>

                        <avalonia:PieChart Classes="chart"
                                           Series="{Binding UserActivitySeries}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Border Classes="item-card"
                                    Grid.Column="0">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="name"
                                               Text="{localization:Localize ServerStatsPage.UserActivity.Active}" />
                                    <TextBlock Classes="number"
                                               Text="{Binding ServerStats.ActiveUsers}" />
                                </StackPanel>
                            </Border>

                            <Border Classes="item-card"
                                    Grid.Column="1">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="name"
                                               Text="{localization:Localize ServerStatsPage.UserActivity.Inactive}" />
                                    <TextBlock Classes="number"
                                               Text="{Binding ServerStats.InactiveUsers}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="20">
                        <Grid Classes="section-title"
                              ColumnDefinitions="Auto,Auto,*">
                            <icon:MaterialIcon Grid.Column="0"
                                               Classes="icon"
                                               Kind="Bookshelf" />
                            <TextBlock Grid.Column="1"
                                       Text="{localization:Localize ServerStatsPage.Content.Title}" />
                        </Grid>

                        <Grid RowDefinitions="Auto,Auto" RowSpacing="16">
                            <StackPanel Grid.Row="0" Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="{localization:Localize ServerStatsPage.Content.Series}" FontSize="14"
                                           FontWeight="Medium" />
                                <TextBlock Text="{Binding ServerStats.Series}"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Spacing="4" HorizontalAlignment="Center">
                                <icon:MaterialIcon Classes="icon"
                                                   Kind="BookOpenVariantOutline" />
                                <TextBlock Text="{localization:Localize ServerStatsPage.Content.Chapters}"
                                           FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="{Binding ServerStats.Chapters}"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="20">
                        <Grid Classes="section-title"
                              ColumnDefinitions="Auto,Auto,*">
                            <icon:MaterialIcon Grid.Column="0"
                                               Classes="icon"
                                               Kind="Bookshelf" />
                            <TextBlock Grid.Column="1"
                                       Text="{localization:Localize ServerStatsPage.LibraryDistribution.Title}" />
                        </Grid>

                        <avalonia:PieChart Classes="chart"
                                           Series="{Binding LibraryDistributionSeries}" />
                    </StackPanel>
                </Border>
            </controls:StretchWrapPanel>

            <Border Classes="card">
                <StackPanel Spacing="20">
                    <Grid Classes="section-title"
                          ColumnDefinitions="Auto,Auto,*">
                        <TextBlock Grid.Column="0"
                                   Text="🚫" />
                        <TextBlock Grid.Column="1"
                                   Text="{localization:Localize ServerStatsPage.NeverRead.Title}" />
                    </Grid>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding NeverReadSeries}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="16" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <previews:SeriePreview Serie="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>